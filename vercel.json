{
  "version": 2,
  "builds": [
    {
      "src": "techshop/techshop_proj/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "includeFiles": "staticfiles/**"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "techshop/techshop_proj/wsgi.py"
    }
  ]
}
